# Copy to apps/web/.env.local for local development.
# Render reads these from its dashboard (see render.yaml).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never expose to the client.
# Used by Phase 1 ingestion scripts and admin server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
